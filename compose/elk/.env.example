# Environment variables for Elasticsearch, Logstash, Kibana
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_BOOTSTRAP_MEMORY_LOCK=true
ELASTICSEARCH_XPACK_SECURITY_ENABLED=false
ELASTICSEARCH_XPACK_SECURITY_AUDIT_ENABLED=false
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
LOGSTASH_PORT=5044
LOGSTASH_DEBUG_PORT=9600
LOGSTASH_JAVA_OPTS=-Xms256m -Xmx256m
KIBANA_PORT=5601
KIBANA_ELASTICSEARCH_HOSTS=http://elasticsearch:9200